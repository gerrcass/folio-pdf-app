{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "description": "Folio — a local-first PDF reader and annotation app for Windows, with a browser edition.",
  "author": "Folio contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "prebuild:web": "node scripts/copy-pdf-assets.mjs",
    "pree2e": "node scripts/copy-pdf-assets.mjs",
    "build": "node scripts/build.mjs desktop",
    "build:web": "node scripts/build.mjs web",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=browser",
    "test:electron": "npm run build && playwright test --project=electron",
    "bench": "node scripts/benchmark.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build:web",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "6.8.11",
    "lucide-react": "1.63.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
